APP_NAME=digital-employee-assistant
APP_ENV=dev
APP_HOST=0.0.0.0
APP_PORT=8001
APP_DEBUG=true

MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=123456
MYSQL_DATABASE=digital_employee

DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
LLM_PROVIDER=mock
LLM_TIMEOUT=30
LLM_MAX_TOKENS=2048

EMBEDDING_PROVIDER=fastembed
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
EMBEDDING_DIMENSION=512

QDRANT_MODE=local
QDRANT_LOCAL_PATH=./storage/qdrant
QDRANT_COLLECTION=knowledge_cards
QDRANT_DISTANCE=COSINE

SIMILARITY_THRESHOLD=0.75
TOP_K=5

LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=digital-employee-assistant
LANGSMITH_ENDPOINT=
LANGSMITH_HIDE_INPUTS=true
LANGSMITH_HIDE_OUTPUTS=true

WECOM_ENABLED=false
WECOM_MOCK_ENABLED=true
WECOM_CORP_ID=
WECOM_AGENT_ID=
WECOM_SECRET=
WECOM_TOKEN=
WECOM_ENCODING_AES_KEY=
WECOM_BOT_KEY=
WECOM_CALLBACK_PATH=/api/wecom/callback
WECOM_DEDUP_TTL_SECONDS=86400

MOCK_MODE=true
