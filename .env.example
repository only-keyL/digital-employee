# ============================================================
# 数字员工助手 — 本地开发环境示例（APP_ENV=dev）
# 复制为 .env 后按需修改；dev 允许 mock LLM、本地 Qdrant、root 数据库账号
# ============================================================

# --- 基础运行 ---
APP_NAME=digital-employee-assistant
APP_ENV=dev
APP_HOST=0.0.0.0
APP_PORT=8001
APP_DEBUG=true
DEBUG=true

# --- 数据库（二选一：DATABASE_URL 或拆分 MySQL 配置）---
# DATABASE_URL=mysql+pymysql://user:password@127.0.0.1:3306/digital_employee
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=change_me
MYSQL_DATABASE=digital_employee

# --- LLM（dev 可使用 mock）---
LLM_PROVIDER=mock
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=
LLM_MODEL=deepseek-v4-flash
LLM_TIMEOUT_SECONDS=15
LLM_MAX_RETRIES=2
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=2048

# --- Embedding（Stage3 RAG 必需真实向量；disabled 不允许伪造）---
EMBEDDING_PROVIDER=openai_compatible
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=
EMBEDDING_VECTOR_SIZE=512
EMBEDDING_DIMENSION=512
EMBEDDING_TIMEOUT_SECONDS=15
EMBEDDING_MAX_RETRIES=2

# --- Qdrant / 向量检索（dev 可使用 local）---
VECTOR_PROVIDER=qdrant
QDRANT_MODE=local
QDRANT_DEPLOYMENT=cloud
QDRANT_LOCAL_PATH=./storage/qdrant
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION=knowledge_cards
QDRANT_RAG_COLLECTION=
QDRANT_DISTANCE=COSINE
QDRANT_TOP_K=5
QDRANT_SCORE_THRESHOLD=0.75
QDRANT_TIMEOUT_SECONDS=5

# --- Redis（本阶段仅配置字段，尚未接入客户端）---
REDIS_URL=
WECOM_DEDUP_TTL_SECONDS=86400
DEPOSIT_SESSION_TTL_SECONDS=600

# --- LangSmith（dev 可关闭）---
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=digital-employee-dev
LANGSMITH_ENDPOINT=
LANGSMITH_HIDE_INPUTS=true
LANGSMITH_HIDE_OUTPUTS=true

# --- 企业微信（dev 可关闭真实回调）---
WECOM_ENABLED=false
WECOM_MOCK_ENABLED=true
WECOM_CORP_ID=
WECOM_AGENT_ID=
WECOM_SECRET=
WECOM_TOKEN=
WECOM_ENCODING_AES_KEY=
WECOM_BOT_KEY=
WECOM_CALLBACK_PATH=/api/wecom/callback
WECOM_CALLBACK_URL=

MOCK_MODE=true
