# ============================================================
# 数字员工助手 — 生产环境示例（APP_ENV=prod）
# 警告：本文件仅为字段结构参考，所有值为占位符，禁止直接复制上线！
# 部署前必须替换为真实配置，并通过 scripts/prod/check_prod_config.py 校验
# ============================================================

# --- 基础运行 ---
APP_NAME=digital-employee-assistant
APP_ENV=prod
APP_HOST=0.0.0.0
APP_PORT=8001
APP_DEBUG=false
DEBUG=false

# --- 数据库（生产禁止使用 root 账号）---
MYSQL_HOST=your-mysql-host.example.com
MYSQL_PORT=3306
MYSQL_USER=dea_prod
MYSQL_PASSWORD=change_me
MYSQL_DATABASE=digital_employee_prod

# --- LLM（生产禁止 mock）---
LLM_PROVIDER=deepseek
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=your_llm_api_key
LLM_MODEL=deepseek-v4-flash
LLM_TIMEOUT_SECONDS=15
LLM_MAX_RETRIES=2
LLM_TEMPERATURE=0.2

# --- Embedding ---
EMBEDDING_PROVIDER=fastembed
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
EMBEDDING_DIMENSION=512

# --- Qdrant（生产必须 remote + cloud）---
VECTOR_PROVIDER=qdrant
QDRANT_MODE=remote
QDRANT_DEPLOYMENT=cloud
QDRANT_URL=https://your-qdrant-cluster.example.com
QDRANT_API_KEY=your_qdrant_api_key
QDRANT_COLLECTION=digital_employee_knowledge_prod
QDRANT_TOP_K=5
QDRANT_SCORE_THRESHOLD=0.65
QDRANT_TIMEOUT_SECONDS=5

# --- Redis（生产必须配置）---
REDIS_URL=redis://:change_me@your-redis-host:6379/0
WECOM_DEDUP_TTL_SECONDS=86400
DEPOSIT_SESSION_TTL_SECONDS=600

# --- LangSmith（生产必须启用）---
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=your_langsmith_api_key
LANGSMITH_PROJECT=digital-employee-prod
LANGSMITH_HIDE_INPUTS=true
LANGSMITH_HIDE_OUTPUTS=true

# --- 企业微信（生产必须启用真实回调）---
WECOM_ENABLED=true
WECOM_MOCK_ENABLED=false
WECOM_CORP_ID=your_corp_id
WECOM_AGENT_ID=your_agent_id
WECOM_SECRET=your_wecom_secret
WECOM_TOKEN=your_wecom_token
WECOM_ENCODING_AES_KEY=your_encoding_aes_key
WECOM_CALLBACK_URL=https://your-domain.example.com/api/wecom/callback

MOCK_MODE=false
