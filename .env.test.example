# ============================================================
# 数字员工助手 — 测试环境示例（APP_ENV=test）
# 复制为 .env 后替换占位符；不可直接用于生产
# test 允许 mock LLM，但应使用独立测试库与 _test 集合
# ============================================================

# --- 基础运行 ---
APP_NAME=digital-employee-assistant
APP_ENV=test
APP_HOST=0.0.0.0
APP_PORT=8001
APP_DEBUG=false
DEBUG=false

# --- 数据库 ---
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=test_user
MYSQL_PASSWORD=change_me
MYSQL_DATABASE=digital_employee_test

# --- LLM ---
LLM_PROVIDER=mock
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=
LLM_MODEL=deepseek-v4-flash
LLM_TIMEOUT_SECONDS=15
LLM_MAX_RETRIES=2
LLM_TEMPERATURE=0.2

# --- Embedding（Stage3 RAG 必需真实向量；disabled 不允许伪造）---
EMBEDDING_PROVIDER=openai_compatible
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=
EMBEDDING_VECTOR_SIZE=512
EMBEDDING_DIMENSION=512
EMBEDDING_TIMEOUT_SECONDS=15
EMBEDDING_MAX_RETRIES=2

# --- Qdrant ---
VECTOR_PROVIDER=qdrant
QDRANT_MODE=local
QDRANT_DEPLOYMENT=cloud
QDRANT_LOCAL_PATH=./storage/qdrant_test
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION=digital_employee_knowledge_test
QDRANT_RAG_COLLECTION=digital_employee_knowledge_rag_test
QDRANT_TOP_K=5
QDRANT_SCORE_THRESHOLD=0.65
QDRANT_TIMEOUT_SECONDS=5

# --- Redis ---
REDIS_URL=
WECOM_DEDUP_TTL_SECONDS=86400
DEPOSIT_SESSION_TTL_SECONDS=600

# --- LangSmith ---
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=digital-employee-test
LANGSMITH_HIDE_INPUTS=true
LANGSMITH_HIDE_OUTPUTS=true

# --- 企业微信 ---
WECOM_ENABLED=false
WECOM_MOCK_ENABLED=true
WECOM_CORP_ID=
WECOM_AGENT_ID=
WECOM_SECRET=
WECOM_TOKEN=
WECOM_ENCODING_AES_KEY=
WECOM_CALLBACK_URL=

MOCK_MODE=true
